# Copy this to .env for local development, or set these as environment
# variables in your host's dashboard (Vercel/Netlify project settings).
#
# These are the Supabase *publishable* URL and anon key — safe to expose
# in client-side code. Row Level Security policies (set up in the
# `projects` table and `project-images` storage bucket) control what an
# anonymous visitor vs. a logged-in admin can actually do.
#
# If you don't set these, the site automatically falls back to the
# bundled static data in src/data/projects.js.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
